{
  "name": "manufacturing-erp-system",
  "version": "1.0.0",
  "private": true,
  "description": "Manufacturing ERP & Barcode System Monorepo",
  "scripts": {
    "postinstall": "npm --prefix backend install",
    "build": "npm --prefix backend install && npm --prefix backend run build",
    "start": "npm --prefix backend run start",
    "dev": "npm --prefix backend run start",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "migrate:supabase": "npm --prefix backend run migrate:supabase"
  }
}
