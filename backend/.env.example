# Server Configuration
PORT=5001
NODE_ENV=production

# ---------------------------------------------------------------------------
# Database - Supabase (Postgres)  [current setup]
# Supabase dashboard -> Connect -> copy the "Session pooler" (port 5432) or
# "Transaction pooler" (port 6543) connection string. Use a pooler host
# (aws-0-<region>.pooler.supabase.com): the direct db.<ref>.supabase.co host is IPv6-only
# and is unreachable from IPv4-only hosts such as Render.
# If the database password contains special characters (@ : / # ?), URL-encode them.
# ---------------------------------------------------------------------------
DB_TYPE=postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<your-db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# SSL is on by default for Postgres. Set DB_SSL=false ONLY for a local Postgres without TLS.
DB_SSL=true

# ---------------------------------------------------------------------------
# Database - MySQL (legacy alternative; leave DATABASE_URL/DB_TYPE above unset to use it)
# ---------------------------------------------------------------------------
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASS=your_db_password
# DB_NAME=barcode
# DB_SSL=false   # true if your cloud MySQL provider requires SSL (Aiven, Railway, ...)
# or a full URL: DATABASE_URL=mysql://username:password@host:3306/barcode

# Authentication
JWT_SECRET=replace_this_with_a_long_random_secret_for_production

# CORS Configuration
# Set to your Vercel frontend URL (e.g. https://your-erp.vercel.app)
FRONTEND_URL=https://your-erp.vercel.app
# Additional comma-separated origins if needed
CORS_ORIGINS=https://your-erp.vercel.app,http://localhost:3000

# AI / Gemini API Configuration (Optional: for AI Assistant & Gate Risk analysis)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
