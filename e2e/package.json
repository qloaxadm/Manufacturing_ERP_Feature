{
  "name": "erp-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for the Manufacturing ERP (API + browser)",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "dotenv": "^16.3.1",
    "mysql2": "^3.7.0",
    "typescript": "^5.4.0"
  }
}
